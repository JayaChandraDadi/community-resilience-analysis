   "source": [
    "# Filter rows where source and destination counties are the same\n",
    "bp_df = df[df['from_cnt'] == df['to_cnt']].copy()\n",
    "\n",
    "# Confirm structure\n",
    "print(bp_df[['origin_census_block_group', 'destination_cbg', 'device_count', \n",
    "             'destination_device_count', 'year', 'uid']].head())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "b56d9bac-ad0a-4ddd-827f-187131c044d7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert UID (day of year) to datetime\n",
    "bp_df['date'] = pd.to_datetime(bp_df['uid'], format='%j', errors='coerce')\n",
    "bp_df['month'] = bp_df['date'].dt.month\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "5d434336-0e27-4fc6-82d8-5ec895cab6db",
